        "com.joellithgow.modes": {
          "dark": "{palette.ink.950}"
        }
      }
    },
    "surface": {
      "$type": "color",
      "$value": "{palette.paper.0}",
      "$description": "Cards, panels, menus.",
      "$extensions": {
        "com.joellithgow.modes": {
          "dark": "{palette.ink.900}"
        }
      }
    },
    "text": {
      "$type": "color",
      "$value": "{palette.ink.950}",
      "$description": "Body text and headings.",
      "$extensions": {
        "com.joellithgow.modes": {
          "dark": "{palette.paper.50}"
        }
      }
    },
    "text-muted": {
