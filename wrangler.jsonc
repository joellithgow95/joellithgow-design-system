// The example site on Cloudflare Workers static assets (no Worker script).
// Deployed by .github/workflows/deploy.yml.
//
// No `routes` here on purpose: the ds.joellithgow.com custom domain is owned by
// jlithgow-ops (terraform/workers.tf), so wrangler only uploads code and never
// touches the hostname. Don't add routes back.
{
  "$schema": "https://unpkg.com/wrangler@4.151.1/config-schema.json",
  "name": "joellithgow-design-system",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./example/dist"
  },
  "workers_dev": false,
  "preview_urls": false
}
